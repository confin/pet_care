# 复制本文件为 .env.local 后填入真实值;.env.local 已被 .gitignore 排除,不会进版本库。

# === Supabase Session Pool 连接串(必填) ===
# 获取路径:Supabase Dashboard → Project → Settings → Database
#   → Connection string → "Session pooler" 标签页(端口 5432)
# 形如:postgres://postgres.[ref]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres
# 关键:必须用 "Session pooler" 端口,不要用直连 6543(transaction)或 5432 直接连接
SUPABASE_DB_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# === 企业微信应用消息(失败告警用,留空即关闭通知) ===
# 来自项目 AGENTS.md 文档登记;若调整需同步更新 docs/AGENTS.md
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TO_USER=
